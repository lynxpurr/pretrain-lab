data/raw/*
!data/raw/SHA256SUMS
data/shards/*
!data/shards/SHA256SUMS
data/day1-char20m/*
!data/day1-char20m/SHA256SUMS
data/*.bin
data/*.idx
data/tokenizer/**

# 训练运行产物（证据快照拷 reports/，原始 logs 不入库）
logs/
out/

# venv（D-07：uv 托管解释器）
.venv*/

