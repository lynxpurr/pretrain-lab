# 语料与数据产物（大文件不入库；指纹文件例外——跨机对账需要）
# 注意：目录整体忽略会让 ! 例外失效，必须用 dir/* 形式
data/raw/*
!data/raw/SHA256SUMS
data/shards/*
!data/shards/SHA256SUMS
data/day1-char20m/*
!data/day1-char20m/SHA256SUMS
data/tokenizer-32k/*
!data/tokenizer-32k/SHA256SUMS
data/sft-mix/*
!data/sft-mix/SHA256SUMS
data/sft-mix-v2/*
!data/sft-mix-v2/SHA256SUMS
data/sft-mix-v2b/*
!data/sft-mix-v2b/SHA256SUMS
data/sft-extra-v2/*
!data/sft-extra-v2/SHA256SUMS
data/bpe-smoke/
data/*.bin
data/*.idx
data/tokenizer/**

# 训练运行产物（证据快照拷 reports/，原始 logs 不入库）
logs/
out/

# venv（D-07：uv 托管解释器）
.venv*/

# Python
__pycache__/
*.pyc
.pytest_cache/

# 其他
.DS_Store
*.log
# reports/ 是证据快照（只增不改），原始 log 必须入库（Day 2 发现 Day 1 日志曾被 *.log 误伤）
!reports/*.log
reports/**/*.tmp

# 本地 agent 配置/规程（私有，不随仓库发布）
.zcode/

# 内部过程记录（保留本地，不随公开仓库发布）
